#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Gravitational, Inc.
# kata-identity: render tbot's configuration from the guest kernel command line.
#
# Cluster-wide values arrive from the RuntimeClass drop-in's kernel_params;
# per-pod values from the pod annotation
#   io.katacontainers.config.hypervisor.kernel_params
# which the Kata runtime merges by key into the RuntimeClass values.
#
# Parameters (no spaces in values; the kernel command line is space-separated):
#
#   tbot.proxy=HOST:PORT               Teleport Proxy address.            required
#   tbot.token=NAME                    bound_keypair join token name.     required
#   tbot.secret=SECRET                 Its one-time registration secret.  required
#   tbot.app_proxy=PORT                HTTP proxy to every app the bot may access,
#                                      on 127.0.0.1:PORT.
#   tbot.app.NAME=PORT                 Tunnel to app NAME on 127.0.0.1:PORT.
#   tbot.db.SERVICE=PORT:USER:DB       Tunnel to database SERVICE on 127.0.0.1:PORT,
#                                      connecting as USER to database DB.
#   tbot.ttl=DURATION                  Certificate TTL (default 1h), e.g. 30m.
#   tbot.diag_port=PORT                Diagnostics port (default 41950).
#   tbot.debug=1                       Verbose tbot logging.
#
# NOTE: /proc/cmdline is readable inside every container in the VM, so the
# workload can read tbot.secret. That is acceptable only because a bound_keypair
# registration secret is single-use: it is consumed by tbot's first join, which
# completes before any workload process starts (see the prestart hook).
#
# Writes YAML to stdout. Exits non-zero, writing nothing to stdout, on any
# invalid or missing value.
set -euo pipefail

# shellcheck source-path=SCRIPTDIR source=common.sh
. "$(dirname "$(readlink -f "$0")")/common.sh"

die() { echo "kata-identity: $*" >&2; exit 2; }

re_hostport='^(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9.-]+):[0-9]{1,5}$'
re_name='^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$'
re_secret='^[A-Za-z0-9._~+/=-]{1,512}$'
re_dbident='^[A-Za-z0-9._@-]{1,128}$'
re_duration='^[0-9]+(s|m|h)$'

declare -A used_ports=()
claim_port() { # PORT WHAT
	local port="$1" what="$2"
	if ! [[ "${port}" =~ ^[0-9]{1,5}$ ]] || ((port < 1024 || port > 65535)); then
		die "${what}: port '${port}' must be 1024-65535 (tbot runs unprivileged)"
	fi
	[[ -z "${used_ports[${port}]:-}" ]] ||
		die "${what}: port ${port} already used by ${used_ports[${port}]}"
	used_ports[${port}]="${what}"
}

proxy="$(ki_cmdline_get tbot.proxy || true)"
token="$(ki_cmdline_get tbot.token || true)"
secret="$(ki_cmdline_get tbot.secret || true)"
ttl="$(ki_cmdline_get tbot.ttl || true)"
debug="$(ki_cmdline_get tbot.debug || true)"
diag_addr="$(ki_diag_addr)"

[[ -n "${proxy}" ]] || die "tbot.proxy is not set (RuntimeClass kernel_params)"
[[ -n "${token}" ]] || die "tbot.token is not set (pod annotation kernel_params)"
[[ -n "${secret}" ]] || die "tbot.secret is not set (pod annotation kernel_params)"
[[ "${proxy}" =~ ${re_hostport} ]] || die "tbot.proxy '${proxy}' is not HOST:PORT"
[[ "${token}" =~ ${re_name} ]] || die "tbot.token has invalid characters"
[[ "${secret}" =~ ${re_secret} ]] || die "tbot.secret has invalid characters"
[[ -z "${ttl}" || "${ttl}" =~ ${re_duration} ]] || die "tbot.ttl '${ttl}' is not like 30m or 1h"
claim_port "${diag_addr##*:}" "tbot.diag_port"

services=()

app_proxy="$(ki_cmdline_get tbot.app_proxy || true)"
if [[ -n "${app_proxy}" ]]; then
	claim_port "${app_proxy}" "tbot.app_proxy"
	services+=("  - type: application-proxy
    name: app-proxy
    listen: tcp://127.0.0.1:${app_proxy}")
fi

read -r -a words <"${KI_CMDLINE}"
for word in "${words[@]}"; do
	key="${word%%=*}"
	value="${word#*=}"
	[[ "${word}" == *=* ]] || value=""
	case "${key}" in
	tbot.app.*)
		name="${key#tbot.app.}"
		[[ "${name}" =~ ${re_name} ]] || die "${key}: invalid app name"
		claim_port "${value}" "${key}"
		services+=("  - type: application-tunnel
    name: app-${name}
    listen: tcp://127.0.0.1:${value}
    app_name: '${name}'")
		;;
	tbot.db.*)
		name="${key#tbot.db.}"
		[[ "${name}" =~ ${re_name} ]] || die "${key}: invalid database service name"
		IFS=: read -r port user db <<<"${value}"
		claim_port "${port}" "${key}"
		[[ -n "${user:-}" && -n "${db:-}" ]] ||
			die "${key}: expected PORT:USER:DB (tbot needs both a user and a database)"
		[[ "${user}" =~ ${re_dbident} && "${db}" =~ ${re_dbident} ]] ||
			die "${key}: invalid database user or name"
		services+=("  - type: database-tunnel
    name: db-${name}
    listen: tcp://127.0.0.1:${port}
    service: '${name}'
    username: '${user}'
    database: '${db}'")
		;;
	esac
done

cat <<EOF
# Generated by kata-identity from the guest kernel command line. Do not edit.
version: v2
proxy_server: '${proxy}'
onboarding:
  join_method: bound_keypair
  token: '${token}'
  bound_keypair:
    registration_secret: '${secret}'
storage:
  type: directory
  path: ${KI_TBOT_STORAGE}
credential_ttl: ${ttl:-1h}
diag_addr: ${diag_addr}
debug: $([[ "${debug}" == 1 ]] && echo true || echo false)
EOF
if ((${#services[@]})); then
	echo "services:"
	printf '%s\n' "${services[@]}"
else
	echo "services: []"
fi
